# Copy this file to .env and fill in your own values. .env is git-ignored - never commit it.
# Free key: https://aistudio.google.com/apikey
# On the free tier Google may review what is sent and use it to improve its products, so use a
# billed project (or no key at all) with real classroom photos and student work.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Used when GEMINI_MODEL is overloaded, times out or no longer exists. Empty = no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# PUBLIC_URL=https://your-domain.example
